# -----------------------------------------------------------------------------
# PawCue environment configuration (placeholder codename — see ARCHITECTURE.md)
# Copy to .env.local (mobile) / supabase/.env (functions) and fill in per-environment.
# NEVER commit a real .env file. See SECURITY.md.
# -----------------------------------------------------------------------------

# --- Environment selector ---
# local | staging | production
APP_ENV=local

# --- Supabase (public, safe for client bundle) ---
# .env.local            → the staging project (tests, development builds)
# .env.production.local → the production project, for `pnpm test:smoke:production` only. Store builds take these
#                         from the EAS `production` environment, never from a file (see docs/release/production-supabase.md).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server only — Edge Functions, never shipped to the client) ---
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- API ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:54321/functions/v1

# --- Legal links (public; required on the paywall for an auto-renewing subscription; release-blocking until set) ---
# A production build refuses to start without both (apps/mobile/plugins/withReleaseHardening.js). Drafts live in
# docs/legal/; they are published only after review and only at a real domain.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# --- RevenueCat, client side: PUBLIC SDK keys (appl_… / goog_…). Publishable by design. ---
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# --- RevenueCat, server side (Edge Functions only — `supabase secrets set`, never EXPO_PUBLIC_) ---
# sk_… secret API key: lets purchases-verify and the webhook ask RevenueCat what a subscriber holds.
REVENUECAT_SECRET_API_KEY=
# The value the RevenueCat dashboard is configured to send in the webhook's Authorization header.
REVENUECAT_WEBHOOK_AUTH=

# --- Apple ---
# Sign in with Apple is native (identity token → Supabase). It needs no secret here: only the App ID capability
# (Apple Developer) and the Apple provider enabled with client id com.pawcue.app on the Supabase project.
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=com.pawcue.app
APPLE_SIGN_IN_SERVICE_ID=
APPLE_APP_STORE_SHARED_SECRET=
APPLE_APP_STORE_SERVER_NOTIFICATIONS_KEY_ID=
APPLE_APP_STORE_SERVER_NOTIFICATIONS_ISSUER_ID=
APPLE_APP_STORE_SERVER_NOTIFICATIONS_PRIVATE_KEY=

# --- Google ---
GOOGLE_ANDROID_PACKAGE_NAME=com.pawcue.app
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_RTDN_TOPIC=

# --- Billing product IDs (see packages/config/src/billing-products.ts) ---
BILLING_PRODUCT_MONTHLY=premium_monthly
BILLING_PRODUCT_ANNUAL=premium_annual

# --- Crash / observability (interface only until a provider is selected — see ARCHITECTURE.md) ---
CRASH_PROVIDER_DSN=
