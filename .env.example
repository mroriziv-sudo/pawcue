# -----------------------------------------------------------------------------
# PawCue environment configuration (placeholder codename — see ARCHITECTURE.md)
# Copy to .env.local (mobile) / supabase/.env (functions) and fill in per-environment.
# NEVER commit a real .env file. See SECURITY.md.
# -----------------------------------------------------------------------------

# --- Environment selector ---
# local | staging | production
APP_ENV=local

# --- Supabase (public, safe for client bundle) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server only — Edge Functions, never shipped to the client) ---
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- API ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:54321/functions/v1

# --- Apple ---
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=com.pawcue.app
APPLE_SIGN_IN_SERVICE_ID=
APPLE_APP_STORE_SHARED_SECRET=
APPLE_APP_STORE_SERVER_NOTIFICATIONS_KEY_ID=
APPLE_APP_STORE_SERVER_NOTIFICATIONS_ISSUER_ID=
APPLE_APP_STORE_SERVER_NOTIFICATIONS_PRIVATE_KEY=

# --- Google ---
GOOGLE_ANDROID_PACKAGE_NAME=com.pawcue.app
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_RTDN_TOPIC=

# --- Billing product IDs (see packages/config/src/billing-products.ts) ---
BILLING_PRODUCT_MONTHLY=premium_monthly
BILLING_PRODUCT_ANNUAL=premium_annual

# --- Crash / observability (interface only until a provider is selected — see ARCHITECTURE.md) ---
CRASH_PROVIDER_DSN=
